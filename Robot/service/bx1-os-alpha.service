[Unit]
Description=BX1 OS Alpha Management Interface
Documentation=file:/home/arduino/BX1_OS/docs/bx1_os/DEPLOYMENT_GUIDE.md
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/home/arduino/BX1_OS
ConditionPathIsExecutable=/home/arduino/BX1_OS/.venv/bin/python
ConditionPathExists=/home/arduino/BX1_OS/python/config.json
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/BX1_OS
Environment=PYTHONUNBUFFERED=1
Environment=BX1_OS_MILESTONE=ALPHA
Environment=BX1_QUALIFICATION_MODE=1
Environment=BX1_OBSERVER_ONLY=1
Environment=BX1_OS_RELEASE_VERSION=0.4.0
Environment=BX1_BODY_CONFIG=/home/arduino/BX1_OS/python/config.json
Environment=BX1_WEB_ENABLED=1
Environment=BX1_WEB_HOST=0.0.0.0
Environment=BX1_WEB_PORT=8089
Environment=BX1_RUNTIME_DIR=/home/arduino/BX1_OS/runtime
Environment=BX1_LOG_DIR=/home/arduino/BX1_OS/logs
Environment=XDG_CACHE_HOME=/home/arduino/BX1_OS/cache
Environment=TMPDIR=/home/arduino/BX1_OS/runtime/tmp
Environment=BX1_PID_FILE=/run/bx1-os-alpha/service.pid
RuntimeDirectory=bx1-os-alpha
RuntimeDirectoryMode=0750
ExecStart=/home/arduino/BX1_OS/tools/run_bx1_os_management.sh
ExecStartPost=/home/arduino/BX1_OS/tools/check_web_health.sh
Restart=on-failure
RestartSec=10
TimeoutStartSec=40
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/arduino/BX1_OS/runtime /home/arduino/BX1_OS/logs /home/arduino/BX1_OS/cache /home/arduino/BX1_OS/python

[Install]
WantedBy=multi-user.target
