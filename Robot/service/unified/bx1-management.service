[Unit]
Description=BX1 Management UI
After=network-online.target bx1-body.service
Wants=network-online.target
ConditionPathIsDirectory=/home/arduino/BX1/current/management

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/BX1/current/management
EnvironmentFile=-/home/arduino/BX1/config/bx1.env
Environment=BX1_ROOT=/home/arduino/BX1
Environment=BX1_BODY_CONFIG=/home/arduino/BX1/config/config.json
Environment=BX1_RUNTIME_DIR=/home/arduino/BX1/runtime
Environment=BX1_LOG_DIR=/home/arduino/BX1/logs
ExecStart=/home/arduino/BX1/venvs/management/bin/python -m bx1_management --config /home/arduino/BX1/config/management.json --host 0.0.0.0 --port 8089
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ReadWritePaths=/home/arduino/BX1/config /home/arduino/BX1/runtime /home/arduino/BX1/logs

[Install]
WantedBy=multi-user.target
