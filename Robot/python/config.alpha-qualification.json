{
  "schema": "bx1.alpha.qualification.config.v1",
  "app_version": "BX1 OS v0.7.7 Body Speaker Echo Suppression",
  "bx1_os_release_version": "0.7.7-body-speaker-echo-suppression",
  "bx1_os_release_tag": "BX1_OS_v0.7.7_body_speaker_echo_suppression",
  "persistent_modules_root": "/home/arduino/BX1_modules",
  "runtime": { "event_queue_limit": 128 },
  "robot_name": "LEO",
  "management_interface": {
    "enabled": true,
    "architecture_only": true,
    "read_only": true
  },
  "core_telemetry": {
    "enabled": true,
    "observer_only": true,
    "update_interval_seconds": 2.0
  },
  "hardware_observer": {
    "enabled": true,
    "observer_only": true,
    "robot_body_url": "http://127.0.0.1:8088",
    "timeout_seconds": 0.5,
    "exclusive_access": false,
    "device_control": false
  },
  "camera_proxy": {
    "enabled": true,
    "observer_only": true,
    "source": "Existing Robot Body",
    "timeout_seconds": 1.0,
    "default_fps": 8,
    "maximum_fps": 15,
    "maximum_frame_bytes": 2097152,
    "snapshot_refresh_ms": 400,
    "device_access": false,
    "settings_control": false
  },
  "qualification_mode": true,
  "observer_only": true,
  "observer_allow_camera": false,
  "observer_allow_microphone": false,
  "observer_isolation": {
    "actuators_blocked": true,
    "camera_blocked": true,
    "gpio_blocked": true,
    "hardware_bridge_blocked": true,
    "leds_blocked": true,
    "microphone_blocked": true,
    "servos_blocked": true,
    "wheels_blocked": true
  },
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8089,
  "brain_base_url": "",
  "voice_vertical_slice": {
    "event_limit": 250,
    "body_probe_timeout_seconds": 5.0,
    "body_request_timeout_seconds": 240.0,
    "metadata_only": true
  },
  "api_key": "",
  "input_mode": "none",
  "voice_enabled": false,
  "camera_enabled": false,
  "send_periodic_camera_frames": false,
  "send_periodic_vision": false,
  "visual_awareness_enabled": false,
  "idle_life_enabled": false,
  "idle_life_micro_actions_enabled": false,
  "idle_life_self_chatter_enabled": false,
  "expression_engine_enabled": false,
  "expression_idle_head_enabled": false,
  "hardware_auto_apply_on_start": false,
  "hardware_startup_home_servos": false,
  "hardware_doctor_enabled": false,
  "voice_feedback_audio_enabled": false,
  "thinking_feedback_enabled": false,
  "thinking_cues_enabled": false,
  "local_voice_cue_cache_enabled": false,
  "mouth_audio_reactive_enabled": false,
  "tts_enabled": false,
  "hardware_control": {
    "enabled": false,
    "mcu_transport": "disabled",
    "observer_only": true
  },
  "hardware_services": {
    "backend": "simulation",
    "drive": {
      "enabled": false,
      "drive_dry_run": true,
      "rs485_enabled": false,
      "serial_port": ""
    }
  },
  "hardware_registry": {
    "schema": "bx1.hardware_registry.v1",
    "led_buses": {},
    "led_zones": {},
    "servos": {},
    "sensors": {},
    "drive_buses": {}
  },
  "runtime_paths": {
    "cache": "cache",
    "logs": "logs",
    "runtime": "runtime",
    "temporary": "runtime/tmp"
  }
}
