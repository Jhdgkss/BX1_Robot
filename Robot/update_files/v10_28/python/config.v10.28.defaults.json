        "head_pitch": {
            "label": "Head up/down / pitch",
            "role": "head_pitch",
            "device_type": "servo",
            "enabled": true,
            "pin": 10,
            "min_deg": -10,
            "home_deg": 0,
            "max_deg": 10,
            "invert": false,
            "speed_deg_s": 90
