                "brightness_limit": 0.6,
                "colour_order": "GRB",
                "human_addressing": true
            }
        },
        "led_zones": {
            "mouth": {
                "label": "Mouth",
                "bus": "main",
                "enabled": true,
                "start": 1,
                "end": 1,
                "default_colour": "#00ffff",
                "brightness": 0.4
